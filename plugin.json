{
  "id": "nodebb-plugin-integration",
  "name": "NodeBB Integration Layer",
  "description": "AI integration, semantic search, RAG and Qdrant knowledge pipeline for NodeBB",
  "staticDirs": {
    "public": "public"
  },
  "modules": {
    "../admin/plugins/integration.js": "public/js/admin.js"
  },
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "action:post.save",
      "method": "onPostSave"
    },
    {
      "hook": "action:post.edit",
      "method": "onPostEdit"
    },
    {
      "hook": "action:post.delete",
      "method": "onPostDelete"
    },
    {
      "hook": "action:post.restore",
      "method": "onPostRestore"
    },
    {
      "hook": "action:posts.purge",
      "method": "onPostsPurge"
    },
    {
      "hook": "action:topic.delete",
      "method": "onTopicDelete"
    },
    {
      "hook": "action:topic.restore",
      "method": "onTopicRestore"
    },
    {
      "hook": "filter:admin.header.build",
      "method": "addAdminNavigation"
    }
  ],
  "templates": "./public/templates"
}
