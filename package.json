{
  "name": "nodebb-plugin-integration",
  "version": "0.6.0",
  "description": "AI integration layer for NodeBB forums with MCP, semantic search, RAG and Qdrant knowledge pipeline",
  "main": "library.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sergey-ek/nodebb-plugin-integration.git"
  },
  "files": [
    "library.js",
    "plugin.json",
    "src",
    "public",
    "languages",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "nodebb",
    "nodebb-plugin",
    "ai",
    "mcp",
    "model-context-protocol",
    "rag",
    "qdrant",
    "embeddings",
    "semantic-search",
    "knowledge-base"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "cross-env NODE_ENV=test mocha test/*.test.js",
    "check": "find . -type d -name node_modules -prune -o -type f -name \"*.js\" -print0 | xargs -0 -r -n1 node --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "dotenv": "^16.4.7",
    "node-fetch": "^3.3.2",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "mocha": "^12.0.3",
    "proxyquire": "^2.1.3"
  },
  "nbbpm": {
    "compatibility": "^4.4.1"
  },
  "overrides": {
    "undici": "^7.30.1",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
